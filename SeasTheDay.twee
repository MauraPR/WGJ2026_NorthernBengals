:: PassageFooter {"position":"0,200"}
<<script>>
var bgImage;
if (State.variables.bgUsesLevel) {
  bgImage = "bg-" + State.variables.bgType + State.variables.bgLevel;
}
else {
  bgImage = "bg-" + State.variables.bgType;
}
console.log("footer:", bgImage);

document.body.classList.forEach(clrBg => {
  if (clrBg.startsWith('bg-')) {
    document.body.classList.remove(clrBg);
  }
});

document.body.classList.add(bgImage);
<</script>>

:: StoryStylesheet [stylesheet] {"position":"0,100"}
.main-button a {
  display: block; 
  width: 200px; 
  margin: 10px auto; 
  padding: 12px; 
  text-align: center; 
  text-decoration: none; 
  border: 2px solid white; 
  border-radius: 10px; 
  background: #9f9fb380; 
  color: #ffffff;

}
.main-button a:hover {
  transform: scale(1.2)
}

.title a {
  position: fixed;
  left: 70%;
  top: 40%;
  transform: translate(-50%, -50%);
  width: 340px;
  padding: 18px;
  font-size: 2rem;
  font-weight: bold;
  text-align: center;
  text-decoration: none;
  border: 2px solid #ffffffaa;
  border-radius: 12px;
  background: #085a9490;
  color: white;
  box-shadow: 0 0 20px #00000040;
}

.title a:hover {
  transform: translate(-50%, -50%) scale(1.08);
}
.passage-title-page #passages::before {
  display: none;
}
.choice a {
  display: block; 
  width: 100%;
  margin: 0.2rem 0;
  padding: 0.4rem 0.5rem;
  text-align: left; 
  text-decoration: none; 
  border: 1px solid #ffffff40; 
  border-radius: 5px; 
  background: #9f9fb395; 
  color: #ffffff;
  transition: 0.15s ease;
}
.choice a:hover {
  background: #9f9fb350; 
  border-color: #ffffff80;
}
