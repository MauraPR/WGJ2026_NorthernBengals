} */

#passages {
  position: relative;
  width: 80%;
  max-width: 1100px;
  margin: 2rem auto;
  padding: 2rem;
  z-index: 1;
}

#passages::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url('img/bg-blue.png');
  background-size: cover;
  background-position: center;
  opacity: 0.8;
  border-radius: 10px;
  z-index: -1;
}
body.bg-banner #passages::before {
    display: none;
}

html, body {
  margin: 0;
  padding: 0;
  min-height: 100vh
}
body {
  background-size: cover;
  background-position:center;
  background-repeat: no-repeat;
}
