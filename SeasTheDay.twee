:: PassageFooter {"position":"0,200"}
<<script>>
var bgImage;
if (State.variables.bgUsesLevel) {
  bgImage = "bg-" + State.variables.bgType + State.variables.bgLevel;
}
else {
  bgImage = "bg-" + State.variables.bgType;
}
console.log("footer:", bgImage);

document.body.classList.forEach(clrBg => {
  if (clrBg.startsWith('bg-')) {
    document.body.classList.remove(clrBg);
  }
});

document.body.classList.add(bgImage);
<</script>>

:: StoryStylesheet [stylesheet] {"position":"0,100"}
.title {
  color: #085a94;
  size: 200%
}

.main-button a {
  display: block; 
  width: 200px; 
  margin: 10px auto; 
  padding: 12px; 
  text-align: center; 
  text-decoration: none; 
  border: 2px solid white; 
  border-radius: 10px; 
  background: #9f9fb380; 
  color: #ffffff;

}
.main-button a:hover {
  transform: scale(1.2)
}

.choice a {
  display: block; 
  width: 100%;
  margin: 0.2rem 0;
  padding: 0.4rem 0.5rem;
  text-align: left; 
  text-decoration: none; 
  border: 1px solid #ffffff40; 
  border-radius: 5px; 
  background: #9f9fb395; 
  color: #ffffff;
  transition: 0.15 ease;
}
.choice a:hover {
  background: #9f9fb350; 
  border-color: #ffffff80;
}
.howto {
  background-image: url('img/bg-blue.png');
  background-size: cover;

  width: 35%;
  padding: 2rem;
  opacity: 0.85;
  
}
.letter {
  color: #53431f;

}
html, body {
  margin: 0;
  padding: 0;
  min-height: 100vh
}
body {
  background-size: cover;
  background-position:center;
  background-repeat: no-repeat;
}

